{
  "tools": [
    {
      "id": "ffmpeg",
      "check": [
        "ffmpeg",
        "-version"
      ],
      "win": "winget install -e --id Gyan.FFmpeg",
      "mac": "brew install ffmpeg",
      "linux": "sudo apt-get install -y ffmpeg"
    },
    {
      "id": "ffprobe",
      "check": [
        "ffprobe",
        "-version"
      ],
      "note": "installed with ffmpeg"
    },
    {
      "id": "node",
      "check": [
        "node",
        "--version"
      ],
      "note": "Node 22+ recommended (taste-skill needs it)"
    },
    {
      "id": "playwright-cli",
      "check": [
        "playwright-cli",
        "--version"
      ],
      "all": [
        "npm install -g @playwright/cli@latest",
        "playwright-cli install --skills"
      ]
    }
  ],
  "placeholders": {
    "claude": {
      "skillsAgent": "claude-code",
      "uiproAgent": "claude"
    },
    "codex": {
      "skillsAgent": "codex",
      "uiproAgent": "codex"
    }
  },
  "skillsDir": {
    "claude": ".claude/skills",
    "codex": ".agents/skills"
  },
  "skills": [
    {
      "id": "impeccable",
      "dirs": [
        "impeccable"
      ],
      "all": [
        "npx --yes impeccable install"
      ],
      "note": "interactive: pick your agent and say yes to the design hook"
    },
    {
      "id": "taste-skill",
      "dirs": [
        "taste-skill",
        "design-taste-frontend"
      ],
      "all": [
        "npx --yes skills add https://github.com/Leonxlnx/taste-skill --skill design-taste-frontend -g -a {skillsAgent}"
      ]
    },
    {
      "id": "hyperframes",
      "dirs": [
        "hyperframes"
      ],
      "all": [
        "npx --yes hyperframes skills update"
      ]
    },
    {
      "id": "remotion",
      "dirs": [
        "remotion-best-practices",
        "remotion"
      ],
      "all": [
        "npx --yes skills add remotion-dev/skills -g -a {skillsAgent}"
      ]
    },
    {
      "id": "ui-ux-pro-max",
      "dirs": [
        "ui-ux-pro-max",
        "uiuxpro"
      ],
      "all": [
        "npm install -g ui-ux-pro-max-cli",
        "uipro init --ai {uiproAgent}"
      ]
    },
    {
      "id": "gsap-skills",
      "dirs": [
        "gsap-core",
        "gsap",
        "gsap-skills"
      ],
      "all": [
        "npx --yes skills add https://github.com/greensock/gsap-skills -g -a {skillsAgent}"
      ]
    },
    {
      "id": "linkedin-skills",
      "dirs": [
        "linkedin-post-writer",
        "linkedin-skills"
      ],
      "claude": [
        "claude plugin marketplace add sergebulaev/linkedin-skills",
        "claude plugin install linkedin-skills@linkedin-skills"
      ],
      "codex": [
        "npx --yes skills add sergebulaev/linkedin-skills -g -a {skillsAgent}"
      ]
    }
  ],
  "bundled": [
    "motion-designer",
    "ad-creative",
    "content-pattern-analyzer-sms",
    "platform-strategy-sms",
    "social-seo-researcher"
  ]
}
